\RequirePackage[open=true]{bookmark}  %Smaller toc
\typeout{>>> Utils: Package 'TableOfContent' loaded !}

%\RequirePackage{tocloft}
%\RequirePackage{hyperref}



\newcommand{\smallTableOfContent}{  %Reduce the size of Table Of Content #
    \addtocontents{toc}{
    \protect\setlength{\baselineskip}{-20em}
    \protect\setlength{\parskip}{0pt}}
}

\newcommand{\classicalTableOfContent}{  %No reduce the size of Table Of Content #
}

%\makeatletter
%\renewcommand{\contentsline}[4]{%
%  \csname l@#1\endcsname{#2}{\mbox{}}} % Remplace le numéro de page par un espace vide
%\makeatother

\newcommand{\displayTableOfContent}[2] %Display the table of content #tocName
{   
    \newcounter{lastpageofsommaire} % Crée un compteur personnalisé
    \setcounter{page}{#1}
    %\addtocontents{toc}{~\hfill\textbf{#2}\par} 
    %\chapter{#2}
    \phantomsection % Synchronise la table des matières
    %\renewcommand{\contentsline}[3]{\csname l@#1\endcsname{#2}{}}

    \tableofcontents 
    %\setcounter{lastpageofsommaire}{\value{page}} % Stocke le numéro de la dernière page du somm
    %\setcounter{page}{\thelastpageofsommaire}
}
